---
import { site } from '../data/site';

const annee = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer__inner">
    <p class="footer__legal">© {annee} {site.nom} · {site.ville}</p>
    <div class="footer__liens">
      <a href={site.github.url} rel="me noopener">{site.github.label}</a>
      <a href={site.linkedin.url} rel="me noopener">{site.linkedin.label}</a>
    </div>
  </div>
</footer>
