---
/**
 * Icônes Phosphor en duotone (paquet @phosphor-icons/core), lues au build.
 * Le calque clair du duotone prend la couleur courante à 20 % d'opacité.
 * Ajouter une icône = ajouter une entrée dans FICHIERS, nom Phosphor sans suffixe.
 */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  name: string;
  size?: number;
  class?: string;
  label?: string;
}

const { name, size = 22, class: className, label } = Astro.props;

const FICHIERS: Record<string, string> = {
  server: 'hard-drives',
  cloud: 'cloud-arrow-up',
  pulse: 'pulse',
  shield: 'shield-check',
  lock: 'lock-key',
  cpu: 'cpu',
  cycle: 'arrows-clockwise',
  code: 'code',
  menu: 'list',
  document: 'file-text',
  list: 'list-bullets',
  hash: 'hash',
  mail: 'envelope-simple',
  phone: 'phone',
  pin: 'map-pin',
  arrow: 'arrow-right',
  close: 'x',
  'chevron-left': 'caret-left',
  'chevron-right': 'caret-right',
  expand: 'arrows-out',
};

const DOSSIER = join(process.cwd(), 'node_modules/@phosphor-icons/core/assets/duotone');

const fichier = FICHIERS[name] ?? FICHIERS.hash;
const source = readFileSync(join(DOSSIER, `${fichier}-duotone.svg`), 'utf-8');
const d = source.replace(/^<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
---

<svg
  width={size}
  height={size}
  viewBox="0 0 256 256"
  fill="currentColor"
  class={className}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  set:html={label ? `<title>${label}</title>${d}` : d}
/>
