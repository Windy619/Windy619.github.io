---
/**
 * Jeu d'icônes tracées à la main, grille 24, contour 1.5.
 * Ajouter une icône = ajouter une entrée dans PATHS.
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
  label?: string;
}

const { name, size = 22, class: className, label } = Astro.props;

const PATHS: Record<string, string> = {
  server:
    '<rect x="3" y="4" width="18" height="7" rx="1.5"/><rect x="3" y="13" width="18" height="7" rx="1.5"/><path d="M6.8 7.5h.01M6.8 16.5h.01"/>',
  cloud:
    '<path d="M6.5 19a4 4 0 0 1 .5-8 5.5 5.5 0 0 1 10.4 1.4A3.6 3.6 0 0 1 17.4 19z"/><path d="M12 16.5V9.5m0 0-2.2 2.2M12 9.5l2.2 2.2"/>',
  pulse: '<path d="M3 12.5h3.6L9 6.5l3 11 2.3-5h6.7"/>',
  shield:
    '<path d="M12 3.2 5 6.2v5.9c0 4 3 6.6 7 7.9 4-1.3 7-3.9 7-7.9V6.2z"/><path d="M9.2 12.2l2.2 2.2 4.2-4.4"/>',
  lock:
    '<rect x="5" y="10.4" width="14" height="9.6" rx="1.5"/><path d="M8.6 10.4V8a3.4 3.4 0 0 1 6.8 0v2.4"/><path d="M12 14.2v2.2"/>',
  cpu:
    '<rect x="7.2" y="7.2" width="9.6" height="9.6" rx="1.5"/><rect x="10.6" y="10.6" width="2.8" height="2.8"/><path d="M12 3.4v3.8M12 16.8v3.8M3.4 12h3.8M16.8 12h3.8"/>',
  cycle:
    '<path d="M20 12a8 8 0 0 1-13.6 5.7"/><path d="M4 12a8 8 0 0 1 13.6-5.7"/><path d="M17.6 3.6v3.2h-3.2M6.4 20.4v-3.2h3.2"/>',
  code: '<path d="M9.4 6.8 4.4 12l5 5.2"/><path d="M14.6 6.8 19.6 12l-5 5.2"/><path d="M13.2 5.4 10.8 18.6"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  document:
    '<path d="M14 3v4.5h4.5"/><path d="M18.5 7.5V20a1 1 0 0 1-1 1H6.5a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1H14z"/><path d="M9 13h6M9 16.5h4"/>',
  list: '<path d="M4 7h16M4 12h16M4 17h10"/>',
  hash: '<path d="M9 4 7 20M17 4l-2 16M4.5 9h15M3.8 15h15"/>',
  mail:
    '<rect x="3" y="5.5" width="18" height="13" rx="1.5"/><path d="M3.8 6.6 12 13l8.2-6.4"/>',
  phone:
    '<path d="M7.5 3.5h-2A2 2 0 0 0 3.5 5.7C4 12.7 11.3 20 18.3 20.5a2 2 0 0 0 2.2-2v-2l-4-1.5-2 2a14.6 14.6 0 0 1-4-4l2-2z"/>',
  pin: '<path d="M12 21c4-4.6 6-7.8 6-10.4A6 6 0 0 0 6 10.6C6 13.2 8 16.4 12 21z"/><circle cx="12" cy="10.4" r="2.2"/>',
  arrow: '<path d="M4 12h15M13.5 6.5 20 12l-6.5 5.5"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  expand: '<path d="M14.5 4H20v5.5M9.5 20H4v-5.5M20 4l-6.4 6.4M4 20l6.4-6.4"/>',
};

const d = PATHS[name] ?? PATHS.hash;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  set:html={label ? `<title>${label}</title>${d}` : d}
/>
