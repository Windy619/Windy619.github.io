---
interface Props {
  etiquette: string;
  titre?: string;
  lien?: { libelle: string; href: string };
  id?: string;
}

const { etiquette, titre, lien, id } = Astro.props;
---

<div class="section__head">
  <p class="eyebrow" id={id}>{etiquette}</p>
  <div class="rule"></div>
</div>

{
  titre && (
    <div class="section__title">
      <h2>{titre}</h2>
      {lien && (
        <a class="section__link" href={lien.href}>
          {lien.libelle} →
        </a>
      )}
    </div>
  )
}
