---
/**
 * TerminalHero.astro
 * Terminal animé pour le hero : simule une session zsh alimentée par les
 * données de src/data/site.ts.
 * Pur CSS et module JS, aucune dépendance externe.
 */
import { site } from '../data/site';

type Segment = { texte: string; classe?: string };
type Etape = { cmd: string; out: Segment[][] };

const sequence: Etape[] = [
  {
    cmd: 'whoami',
    out: [
      [{ texte: 'windy619', classe: 'term-accent' }, { texte: `  ·  ${site.nom}` }],
      [
        {
          texte: `SRE · DevSecOps · Intégration IA · ${site.experienceAnnees} ans d’expérience`,
          classe: 'term-dim',
        },
      ],
    ],
  },
  {
    cmd: 'systemctl status devwatch',
    out: [
      [
        { texte: '● ' },
        { texte: 'devwatch.service', classe: 'term-accent' },
        { texte: ' : Supervision d’infrastructure' },
      ],
      [
        { texte: '   Active: ' },
        { texte: 'active (running)', classe: 'term-ok' },
        { texte: ' since juil. 2026' },
      ],
      [{ texte: '   Tags:   brute-force SSH · enrichissement IP · astreinte · Mistral' }],
    ],
  },
  {
    cmd: 'cat /etc/stack.conf',
    out: [
      [
        { texte: 'Ops      ', classe: 'term-dim' },
        { texte: '  GitLab CI/CD · Docker · Prometheus · Grafana · Loki' },
      ],
      [
        { texte: 'Cloud    ', classe: 'term-dim' },
        { texte: '  Azure · OVH · AlmaLinux · Debian · OpenNebula' },
      ],
      [
        { texte: 'Backend  ', classe: 'term-dim' },
        { texte: '  Laravel 9–13 · PHP 8.x · MySQL' },
      ],
      [
        { texte: 'Frontend ', classe: 'term-dim' },
        { texte: '  Vue 3 · Inertia.js · TypeScript · Tailwind' },
      ],
      [
        { texte: 'IA       ', classe: 'term-dim' },
        { texte: '  Mistral OCR · n8n · automatisation webhooks' },
      ],
    ],
  },
  {
    cmd: 'ping -c1 disponibilite',
    out: [
      [
        { texte: 'PING ' },
        { texte: site.ville, classe: 'term-accent' },
        { texte: ` (${site.fuseau})` },
      ],
      [
        { texte: '1 packet transmitted, 1 received', classe: 'term-ok' },
        { texte: site.disponibilite ? ` · ${site.disponibilite}` : '' },
      ],
    ],
  },
];

// Résumé statique pour les lecteurs d’écran : le contenu animé duplique la
// prose du hero, le terminal est donc exposé comme une image légendée.
const resume = `Terminal de démonstration : ${site.nom}, SRE, DevSecOps et intégration IA, ${site.experienceAnnees} ans d’expérience, ${site.ville}.`;
---

<div
  class="terminal"
  role="img"
  aria-label={resume}
  data-terminal
  data-sequence={JSON.stringify(sequence)}
>
  <div class="terminal__chrome" aria-hidden="true">
    <div class="terminal__dots">
      <span class="terminal__dot td-red"></span>
      <span class="terminal__dot td-yellow"></span>
      <span class="terminal__dot td-green"></span>
    </div>
    <span class="terminal__title">~/portfolio - zsh</span>
  </div>
  <div class="terminal__body" data-terminal-body>
    <p class="term-line"><span class="term-dim">Last login: Mon Sep  9 12:00:00 2026 on pts/0</span></p>
  </div>
</div>

<script>
  type Segment = { texte: string; classe?: string };
  type Etape = { cmd: string; out: Segment[][] };

  const SPEED = 38; // ms par caractère
  const JITTER = 18; // variation aléatoire, en plus ou en moins
  const POST_CMD = 550; // pause après la frappe, avant la sortie
  const POST_OUT = 2200; // pause après la sortie, avant la commande suivante
  const LOOP_PAUSE = 1200; // pause avant de repartir du début
  const DEMARRAGE = 900; // délai avant la première commande
  const ATTENTE = 400; // intervalle de vérification de la visibilité

  const sleep = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));

  function lireSequence(hote: HTMLElement): Etape[] {
    const brut = hote.dataset.sequence;
    if (!brut) return [];
    try {
      return JSON.parse(brut) as Etape[];
    } catch {
      return [];
    }
  }

  function demarrer(hote: HTMLElement, corps: HTMLElement, sequence: Etape[]) {
    const defiler = () => {
      corps.scrollTop = corps.scrollHeight;
    };

    const creerSpan = (segment: Segment) => {
      const span = document.createElement('span');
      if (segment.classe) span.className = segment.classe;
      span.textContent = segment.texte;
      return span;
    };

    const ajouterLigne = (classes: string) => {
      const ligne = document.createElement('p');
      ligne.className = classes;
      corps.appendChild(ligne);
      return ligne;
    };

    const ajouterInvite = () => {
      const ligne = ajouterLigne('term-line');

      const invite = document.createElement('span');
      invite.className = 'term-prompt';
      invite.setAttribute('aria-hidden', 'true');
      invite.textContent = '❯';

      const saisie = document.createElement('span');
      saisie.className = 'term-typed';

      const curseur = document.createElement('span');
      curseur.className = 'term-caret';
      curseur.setAttribute('aria-hidden', 'true');

      ligne.append(invite, saisie, curseur);
      defiler();
      return { saisie, curseur };
    };

    const ajouterSortie = (lignes: Segment[][]) => {
      for (const segments of lignes) {
        ajouterLigne('term-line term-out').append(...segments.map(creerSpan));
      }
      defiler();
    };

    // Ne garder que la ligne "Last login" posée au rendu.
    const reinitialiser = () => {
      while (corps.children.length > 1) {
        const dernier = corps.lastElementChild;
        if (!dernier) break;
        dernier.remove();
      }
    };

    const taper = async (saisie: HTMLSpanElement, texte: string) => {
      for (const caractere of texte) {
        saisie.textContent += caractere;
        defiler();
        await sleep(SPEED + (Math.random() * JITTER * 2 - JITTER));
      }
    };

    // Sans animation : la session est rendue d’un bloc, dans son état final.
    const rendreStatique = () => {
      reinitialiser();
      for (const etape of sequence) {
        const { saisie, curseur } = ajouterInvite();
        saisie.textContent = etape.cmd;
        curseur.remove();
        ajouterSortie(etape.out);
      }
    };

    let visible = true;
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (entrees) => {
          visible = entrees.some((entree) => entree.isIntersecting);
        },
        { threshold: 0.1 }
      ).observe(hote);
    }

    const attendreVisible = async () => {
      while (!visible || document.hidden) await sleep(ATTENTE);
    };

    const boucler = async () => {
      for (;;) {
        await attendreVisible();
        reinitialiser();
        for (const etape of sequence) {
          const { saisie, curseur } = ajouterInvite();
          await taper(saisie, etape.cmd);
          await sleep(POST_CMD);
          curseur.remove();
          ajouterSortie(etape.out);
          await sleep(POST_OUT);
        }
        await sleep(LOOP_PAUSE);
      }
    };

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      rendreStatique();
      return;
    }

    setTimeout(() => void boucler(), DEMARRAGE);
  }

  const hote = document.querySelector<HTMLElement>('[data-terminal]');
  const corps = hote?.querySelector<HTMLElement>('[data-terminal-body]');

  if (hote && corps) {
    const sequence = lireSequence(hote);
    if (sequence.length > 0) demarrer(hote, corps, sequence);
  }
</script>

<style>
  /* ---- Châssis ---- */
  .terminal {
    font-family: var(--font-mono, monospace);
    font-size: 12px;
    line-height: 1.75;
    border: 1px solid var(--line-2);
    border-radius: var(--radius-lg);
    background: var(--surface-2);
    overflow: hidden;
  }

  /* ---- Barre de titre macOS-style ---- */
  .terminal__chrome {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    background: var(--surface);
    border-block-end: 1px solid var(--line);
    user-select: none;
  }

  .terminal__dots {
    display: flex;
    gap: 6px;
    flex-shrink: 0;
  }

  .terminal__dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }

  .td-red    { background: #ff5f57; }
  .td-yellow { background: #febc2e; }
  .td-green  { background: #28c840; }

  .terminal__title {
    flex: 1;
    text-align: center;
    font-size: 11px;
    color: var(--dim);
    letter-spacing: 0.04em;
    /* compensation optique pour centrer par rapport aux dots */
    padding-inline-end: 66px;
  }

  /* ---- Corps ---- */
  .terminal__body {
    padding: 16px 18px 20px;
    min-height: 220px;
    max-height: 296px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 1px;
    /* Scrollbar discrète */
    scrollbar-width: thin;
    scrollbar-color: var(--line-3) transparent;
  }

  /* Sur grand écran, les 17 lignes de la session tiennent d’un bloc. */
  @media (min-width: 960px) {
    .terminal__body {
      min-height: 456px;
      max-height: 456px;
    }
  }

  /* ---- Lignes ---- */
  .term-line {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 8px;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .term-out {
    padding-inline-start: 16px;
    color: var(--text-2);
    margin-block-start: 1px;
  }

  /* ---- Éléments inline ---- */
  .term-prompt {
    color: var(--accent);
    flex-shrink: 0;
    font-size: 13px;
  }

  .term-typed {
    color: var(--text-strong);
  }

  /* Curseur clignotant blocs */
  .term-caret {
    display: inline-block;
    width: 7px;
    height: 1em;
    background: var(--accent);
    opacity: 0.85;
    vertical-align: text-bottom;
    margin-inline-start: 1px;
    animation: term-blink 1s step-end infinite;
  }

  @keyframes term-blink {
    0%, 100% { opacity: 0.85; }
    50%       { opacity: 0; }
  }

  .term-accent { color: var(--accent); }
  .term-ok     { color: #28c840; }
  .term-dim    { color: var(--dim); }
</style>
