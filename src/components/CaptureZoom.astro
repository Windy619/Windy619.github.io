---
/**
 * CaptureZoom.astro
 * Capture cliquable qui s'ouvre en grand dans une fenetre modale (<dialog>).
 * Fermeture par le bouton, la touche Echap ou un clic en dehors de l'image.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  legende?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'eager' | 'lazy';
}

const {
  src,
  alt,
  legende,
  widths = [720, 1120, 2240],
  sizes = '(min-width: 1168px) 1120px, 100vw',
  loading = 'lazy',
} = Astro.props;
---

<div class="zoom" data-zoom>
  <button class="zoom__declencheur" type="button" aria-haspopup="dialog" data-zoom-ouvrir>
    <Image class="capture" src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} />
    <span class="zoom__indice" aria-hidden="true">
      <Icon name="expand" size={16} />
      Agrandir
    </span>
    <span class="visually-hidden">Agrandir l’image : {alt}</span>
  </button>

  <dialog class="zoom__modale" aria-label={legende ?? alt} data-zoom-modale>
    <div class="zoom__barre">
      <p class="zoom__legende">{legende ?? alt}</p>
      <button class="zoom__fermer" type="button" data-zoom-fermer>
        <Icon name="close" size={20} />
        <span class="visually-hidden">Fermer</span>
      </button>
    </div>
    <div class="zoom__cadre">
      <Image
        class="zoom__image"
        src={src}
        alt={alt}
        widths={[1120, 2240]}
        sizes="100vw"
        loading="lazy"
      />
    </div>
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-zoom]').forEach((bloc) => {
    const modale = bloc.querySelector<HTMLDialogElement>('[data-zoom-modale]');
    const ouvrir = bloc.querySelector<HTMLButtonElement>('[data-zoom-ouvrir]');
    const fermer = bloc.querySelector<HTMLButtonElement>('[data-zoom-fermer]');
    if (!modale || !ouvrir || !fermer) return;

    ouvrir.addEventListener('click', () => {
      modale.showModal();
      document.documentElement.classList.add('zoom-actif');
    });

    fermer.addEventListener('click', () => modale.close());

    // Un clic sur le fond (hors image et hors barre) ferme la modale.
    modale.addEventListener('click', (e) => {
      const cible = e.target as HTMLElement;
      if (cible === modale || cible.classList.contains('zoom__cadre')) modale.close();
    });

    // Echap est gere nativement par <dialog> ; on rend le focus au declencheur.
    modale.addEventListener('close', () => {
      document.documentElement.classList.remove('zoom-actif');
      ouvrir.focus();
    });
  });
</script>
